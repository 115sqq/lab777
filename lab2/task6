#include <stdio.h>

#define MAX 100

void reverse(int *arr, int n) {
    int *left = arr;
    int *right = arr + n - 1;
    int tmp;

    while (left < right) {
        tmp = *left;
        *left = *right;
        *right = tmp;
        left++;
        right--;
    }
}

int main(void) {
    int arr[MAX];
    int n, i;

    printf("Введите количество элементов (1..%d): ", MAX);
    if (scanf("%d", &n) != 1 || n < 1 || n > MAX) {
        printf("Некорректный размер массива\n");
        return 1;
    }

    for (i = 0; i < n; i++) {
        printf("Элемент %d: ", i + 1);
        scanf("%d", arr + i);
    }

    reverse(arr, n);

    printf("Массив после реверса:");
    for (i = 0; i < n; i++) {
        printf(" %d", *(arr + i));
    }
    printf("\n");

    return 0;
}
